# =============================================================================
# Logistics Fleet Dispatch Platform - Environment Configuration Template
# Copy this file to .env and configure your environment variables
# =============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=logistics_db
DB_USERNAME=logistics_user
DB_PASSWORD=logistics_secret_pass
DB_ROOT_PASSWORD=root_secret_pass

# Mail & Notification Configuration (Mailpit)
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=dispatch@logistics-platform.com
MAIL_FROM_NAME="Logistics Dispatch Platform"
